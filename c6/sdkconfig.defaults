# Alvo do projeto: sem isto um clone novo compila para o ESP32 padrao.
CONFIG_IDF_TARGET="esp32c6"

# --- papel: COPROCESSADOR ---------------------------------------------------
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# WiFi: PRECISA ficar ligado. Este firmware substitui o que hoje faz o WiFi do
# Tab5 funcionar - desligar aqui deixaria o aparelho sem rede.
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# O canal de bytes opaco P4 <-> C6. E por ele que o ESP-NOW vai falar.
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y

# BLUETOOTH LIGADO - e a decisao mudou depois de MEDIR.
#
# A primeira versao disto deixava o BT fora, com dois argumentos que nao
# sobreviveram:
#
#   "cabe mais folga no slot" - o BT custa 259KB. Com ele a imagem fica em
#   1,40MB dos 1,75MB do slot padrao, 24% livres. Folga de sobra.
#
#   "menos coisa nova de uma vez" - ao contrario. O C6 e o UNICO radio do Tab5,
#   e o firmware da M5Stack entrega BLE por ele. Tirar o BT nao e "menos
#   mudanca", e uma REGRESSAO: some uma capacidade do aparelho. Manter deixa a
#   imagem nova mais parecida com a que ja esta la, nao menos.
#
# E o risco que restava - "e se o slot real da M5Stack for menor que 1,75MB?" -
# nao e risco: se a imagem nao couber, o esp_ota_write falha no meio, e falhar
# no write e seguro (sem o `end`, a particao de boot nao muda). O pior caso e
# uma tentativa perdida, e ai recompilamos sem BT.
#
# CONTROLLER_ONLY: o C6 roda so o controlador; a stack (NimBLE/Bluedroid) mora
# do lado do P4, que e como o esp_hosted foi desenhado.
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

# --- flash e particoes ------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- REDE DE SEGURANCA ------------------------------------------------------
# A imagem nova sobe em estado PENDENTE. Se ela nao se declarar valida, o
# bootloader volta para a anterior no proximo boot.
#
# Quem faz essa checagem e o BOOTLOADER. A gravacao pelo cabo leva o nosso
# (com esta opcao); uma OTA nao troca o bootloader. Por isso o app_main.c tem
# uma SEGUNDA rede, no nivel do aplicativo, armada so para imagem vinda por OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- EXTRAS DO RADIO (contrato v3): CSI, FTM, 802.15.4 -----------------------
# Cada um dorme ate o P4 pedir. Ligados aqui porque regravar o C6 e fisico
# (Downloader): a gravacao leva tudo que depende do radio de uma vez, e dai em
# diante a evolucao e so do lado do P4. Um bit de CAPS so acende se a flag ficou.
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_INITIATOR_SUPPORT=y
# O outro radio do C6 (802.15.4). No 1o teste ele derrubou o WiFi (associado,
# mas o roteador parou de responder ao ping): faltava a COEXISTENCIA - o
# app_main.c nao chamava esp_coex_wifi_i154_enable(), e sem ela o arbitro de
# RF nao leva o 802.15.4 em conta. Corrigido la; o modulo dorme ate o P4 pedir.
# Se um dia precisar tirar: =n aqui, o modulo some e o bit C6_CAP_154 apaga.
CONFIG_IEEE802154_ENABLED=y

# A tarefa de eventos (sys_evt) roda o tratador do relatorio FTM, que monta a
# mensagem para o P4 na pilha (~300 B). Os 2304 padrao ficavam no limite.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584

# Retrato do travamento na particao 'coredump' (partitions.csv): sobrevive ao
# reinicio, e o INFO avisa o P4 que ha um guardado.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
